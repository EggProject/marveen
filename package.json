{
  "name": "marveen",
  "version": "1.28.1",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun tsc",
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "setup": "bun run scripts/setup.ts",
    "status": "bun run scripts/status.ts",
    "remote-enroll": "bun run scripts/remote-access-enroll.ts",
    "dashboard-user": "bun run scripts/dashboard-user.ts",
    "test": "bun --bun vitest run",
    "coverage": "bun --bun vitest run --coverage",
    "typecheck": "bun tsc --noEmit",
    "syntax-check": "bun --check web/app.js web/sw.js",
    "smoke": "bun playwright test --config=playwright.config.ts"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20 <26"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.231",
    "cron-parser": "5.8.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "bun-types": "1.3.14",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}