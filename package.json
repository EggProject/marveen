{
  "name": "marveen",
  "version": "1.28.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx scripts/setup.ts",
    "status": "tsx scripts/status.ts",
    "remote-enroll": "tsx scripts/remote-access-enroll.ts",
    "dashboard-user": "tsx scripts/dashboard-user.ts",
    "test": "vitest run",
    "test:refactor-coverage": "vitest run --config vitest.refactor-coverage.config.ts --coverage",
    "test:install": "/opt/homebrew/bin/bats scripts/__tests__/installer-provider-prompt.bats && bash scripts/__tests__/installer-push-config.test.sh",
    "test:install:coverage": "/opt/homebrew/bin/bash scripts/__tests__/installer-provider-prompt-coverage.test.sh",
    "typecheck": "tsc --noEmit",
    "syntax-check": "node --check web/app.js web/sw.js",
    "smoke": "playwright test --config=playwright.config.ts"
  },
  "engines": {
    "node": ">=20 <24"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.116",
    "better-sqlite3": "^13.0.2",
    "cron-parser": "^5.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.2": true,
    "esbuild@0.27.3": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
