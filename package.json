{
  "name": "marveen",
  "version": "1.28.1",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun tsc",
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "setup": "bun run scripts/setup.ts",
    "status": "bun run scripts/status.ts",
    "remote-enroll": "bun run scripts/remote-access-enroll.ts",
    "dashboard-user": "bun run scripts/dashboard-user.ts",
    "test": "bun --bun vitest run",
    "test:integration": "MARVEEN_TEST_ALLOW_CHILD_PROCESS=1 MARVEEN_TEST_ALLOW_PROCESS_KILL=1 bun --bun vitest run",
    "test:integration:real-world": "MARVEEN_TEST_DISABLE_FORBID=1 bun --bun vitest run",
    "coverage": "bun --bun vitest run --coverage",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --max-warnings 0",
    "lint:fix": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --fix",
    "typecheck": "bun tsc --noEmit",
    "syntax-check": "node --check web/app.js && node --check web/sw.js",
    "smoke": "bun playwright test --config=playwright.config.ts"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20 <26"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.231",
    "cron-parser": "5.8.1",
    "luxon": "3.7.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/luxon": "3.7.4",
    "@types/node": "26.2.0",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.27",
    "bun-types": "1.3.14",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}